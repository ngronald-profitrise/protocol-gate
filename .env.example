# Copy to `.env` and adjust. The `.env` file is git-ignored.

# --- Ollama (untrusted proposer) ---
PG_OLLAMA_HOST=http://localhost:11434
PG_MODEL=llama3.2:3b
PG_MODEL_TEMPERATURE=0.7
PG_MODEL_TIMEOUT_SECONDS=60

# --- Gate API ---
PG_API_HOST=0.0.0.0
PG_API_PORT=8000
PG_LOG_LEVEL=INFO
PG_MAX_MESSAGE_AGE_SECONDS=300

# --- Observability ---
PG_ENABLE_TRACING=true
PG_OTLP_ENDPOINT=http://localhost:4317
PG_SERVICE_NAME=protocol-gate

# --- Experiment tracking ---
MLFLOW_TRACKING_URI=http://localhost:5000
PG_EXPERIMENT_NAME=protocol-gate-ab

# --- Persistence adapter (memory | postgres) ---
PG_STATE_BACKEND=memory
# When PG_STATE_BACKEND=postgres:
PG_POSTGRES_DSN=postgresql://gate:gate@localhost:5432/protocol_gate
