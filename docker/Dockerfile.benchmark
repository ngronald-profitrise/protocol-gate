# Image for running the control-vs-experiment benchmark harness as a one-shot job.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH="/app/src:/app"

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY experiments ./experiments
COPY benchmarks ./benchmarks

RUN pip install --upgrade pip && pip install ".[bench]"

# Default: run the benchmark suite and write a JSON report to a mounted volume.
ENTRYPOINT ["python", "-m", "benchmarks.runner"]
CMD ["--iterations", "20", "--output", "/results/benchmark.json"]
